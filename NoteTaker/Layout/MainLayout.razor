@inherits LayoutComponentBase

<HeadContent>
  <RadzenTheme Theme="@DefaultTheme" />
</HeadContent>

<RadzenComponents />

<RadzenLayout>
  <RadzenHeader>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-px-4 rz-py-2">
      <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenSidebarToggle Icon="menu" Click="@(() => SidebarExpanded = !SidebarExpanded)" ToggleAriaLabel="Toggle notes" class="rz-m-0" />
        <RadzenText Text="Note Taker" TextStyle="TextStyle.H5" TagName="TagName.Span" class="rz-m-0 rz-color-on-primary" />
      </RadzenStack>
      <RadzenAppearanceToggle />
    </RadzenStack>
  </RadzenHeader>
  <RadzenSidebar @bind-Expanded="SidebarExpanded" Responsive="false">
    <RadzenPanelMenu>
      @foreach (var note in NotesService.Notes)
      {
        <RadzenPanelMenuItem Text="@note.Name" Icon="description" Selected="@(note == NotesService.Current)" Click="@(() => OnNoteClickAsync(note))">
          <Template>
            <span class="note-menu-item">
              <span class="rz-navigation-item-text">@note.Name</span>
              @if (CanDeleteNote(note))
              {
                <span class="delete-note-wrapper" @onclick:stopPropagation="true">
                  <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.ExtraSmall" Click="@(() => OnDeleteNoteClickAsync(note))" class="delete-note-button" title="@($"Delete {note.Name}")" aria-label="@($"Delete {note.Name}")" />
                </span>
              }
            </span>
          </Template>
        </RadzenPanelMenuItem>
      }
    </RadzenPanelMenu>
    <div class="rz-p-4">
      <RadzenStack Gap="0.5rem">
        <RadzenButton Text="Add Note" Icon="add" Click="@OnAddNoteClickAsync" class="rz-w-100" />
        <RadzenButton Text="Export" Icon="download" ButtonStyle="ButtonStyle.Secondary" Click="@OnExportClickAsync" class="rz-w-100 export-button" />
        <RadzenButton Text="Clear All" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@OnClearAllClickAsync" class="rz-w-100 clear-all-button" />
      </RadzenStack>
    </div>
  </RadzenSidebar>
  <RadzenBody>
    <CascadingValue Value="this" IsFixed="true">
      @Body
    </CascadingValue>
  </RadzenBody>
</RadzenLayout>
